# Bootstrap only: python scripts/setup_local.py (local SQLite)
VAULT_OPERATOR_USERNAME=admin
VAULT_OPERATOR_PASSWORD_HASH=
# Required everywhere; base64 of 32 random bytes. Keep stable and securely backed up.
VAULT_ENCRYPTION_KEY=
VAULT_KEY_ID=primary-v1
APP_ORIGIN=http://localhost:8502

# Server-side Supabase credentials (Vercel Backend / FastAPI):
SUPABASE_URL=
# Supabase service-role/secret key (server-side, never anon/publishable)
SUPABASE_KEY=

# Client-side / Next.js / Edge Supabase templates (mapped for frontend SDK / lib/supabase.ts):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provisioning only: Supabase Postgres transaction/session pooler URL.
DATABASE_URL=
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
CRON_SECRET=
# Optional compatible NCHW 160x160, prewhitened FaceNet ONNX model.
FACENET_MODEL_PATH=
