# Bootstrap only: python scripts/setup_local.py (local SQLite)
VAULT_OPERATOR_USERNAME=admin
VAULT_OPERATOR_PASSWORD_HASH=
# Required everywhere; base64 of 32 random bytes. Keep stable and securely backed up.
VAULT_ENCRYPTION_KEY=
VAULT_KEY_ID=primary-v1
APP_ORIGIN=http://localhost:8502

# Server-side Supabase credentials (Cloud Run FastAPI backend):
SUPABASE_URL=
# Supabase service_role secret key (server-side, never anon/publishable)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_KEY=

# Client-side / Firebase Hosting frontend (public SDK / lib/supabase.ts):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Provisioning only: Supabase Postgres transaction/session pooler URL.
DATABASE_URL=

# Zero-Trust Cryptographic Keys (Server Secrets - required in production):
VAULT_DEVICE_SECRET=
VAULT_SIGNING_KEY=
VAULT_AUDIT_SIGNING_KEY=
VAULT_CHECKPOINT_ID=CP-MAIN-01
VAULT_SESSION_TTL_SECONDS=10.0

# Alerting & Worker configuration:
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@example.com
CRON_SECRET=

# Runtime environment (Cloud Run / Production):
ENV=production
PORT=8080

# Optional model paths:
FACENET_MODEL_PATH=
VAULT_BIOMETRIC_PROVIDER=template

